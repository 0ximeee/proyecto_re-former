   <%= form_with model: @user do |form| %>
     <%= form.label :username %>
     <%= form.text_field :username %>
 
     <%= form.label :email %>
     <%= form.email_field :email, placeholder:"ejemplo@correo.com" %>

     <%= form.label :password %>
     <%= form.password_field :password %>

     <%= form.submit "Create User" %>
  <% end %>

